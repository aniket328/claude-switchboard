#!/usr/bin/env python3
# demo stand-in for macOS `security find-generic-password -s <service> -w`: token = profile name
import glob, hashlib, json, os, sys
svc = sys.argv[sys.argv.index('-s') + 1]; name = 'default'
for d in glob.glob(os.path.join(os.environ['CCA_ROOT'], '*')):
    if svc.endswith('-' + hashlib.sha256(d.encode()).hexdigest()[:8]): name = os.path.basename(d)
print(json.dumps({'claudeAiOauth': {'accessToken': name}}))
