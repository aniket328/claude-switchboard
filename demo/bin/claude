#!/usr/bin/env python3
# demo stand-in for `claude auth status`
import json, os, sys
d = os.environ.get('CLAUDE_CONFIG_DIR', '').rstrip('/'); n = os.path.basename(d) if d else 'default'
mail = {'default': 'me@home.example', 'work': 'me@work.example', 'personal': 'me@personal.example', 'client-acme': 'me@acme.example'}
if sys.argv[1:3] == ['auth', 'status']: print(json.dumps({'loggedIn': True, 'email': mail.get(n, 'me@example.com')}))
